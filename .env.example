# Copy to .env.local. Normal access uses public connection values and the signed-in session.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only, trusted origin used for password-reset redirects. No trailing slash.
APP_URL=http://localhost:3000
# Enable only against your synthetic development database. Never enables a bypass.
NEXT_PUBLIC_SYNTHETIC_DATA=true

# Optional SERVER ONLY. Auth user invitations only; never prefix with NEXT_PUBLIC_.
# Enable only after the new provisioning migration, SMTP and email templates are verified.
SUPABASE_AUTH_ADMIN_SECRET=
PACU_INVITATIONS_ENABLED=false
