# Copy to .env.local. Only public connection values are needed by the app.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only, trusted origin used for password-reset redirects. No trailing slash.
APP_URL=http://localhost:3000
# Enable only against your synthetic development database. Never enables a bypass.
NEXT_PUBLIC_SYNTHETIC_DATA=true
